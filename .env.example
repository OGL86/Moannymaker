# Kopier til .env og fyll inn. Denne fila skal ALDRI inn i git eller deles.

# Egen RPC anbefales (Helius/QuickNode e.l.) – den offentlige er treg og rate-limitet
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Kun for live-modus: sti til bot-walletens nøkkelfil (lag med: python -m memebot wallet-new)
SOLANA_KEYPAIR_PATH=

# Valgfritt: Telegram-varsler (lag bot via @BotFather, finn chat-id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Valgfritt: PumpPortal API-nøkkel (trengs ikke for migrasjonsstrømmen)
PUMPPORTAL_API_KEY=
DASHBOARD_TOKEN=
